# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=globetrotter-super-secret-key-change-in-production

# PostgreSQL Database Configuration (used by Docker Compose and local PostgreSQL)
POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=globetrotter_password
POSTGRES_DB=globetrotter_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URI (set to PostgreSQL, or leave empty for auto-fallback to SQLite when running locally)
DATABASE_URL=postgresql://globetrotter:globetrotter_password@localhost:5432/globetrotter_db

# File Upload Settings
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216
